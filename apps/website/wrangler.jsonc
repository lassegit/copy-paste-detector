{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "copy-paste-detector-website",
  "main": "dist/server/main.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/cloudflare/assets",
    "binding": "ASSETS",
  },
}
