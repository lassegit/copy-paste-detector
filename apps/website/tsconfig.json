{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "react"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "rshono.config.ts"],
  "exclude": ["node_modules", "dist"]
}
